<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>FastPassword.App</RootNamespace>
    <AssemblyName>FastPassword</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>

    <!--
      ┌─ 打包方式：刻意不走 MSIX / APPX ────────────────────────────────────────┐

      WindowsPackageType=None 表示产出**非打包（unpackaged）**应用，与 打包.bat 的
      两种 zip 分发方式配套。这不是"还没来得及做 MSIX"，是明确的产品选择。

      为什么不打包——三条理由都落在数据位置上（见 VaultLocation / SettingsStore）：

      1. 数据目录在 exe 旁边（AppContext.BaseDirectory\data）。MSIX 装到
         C:\Program Files\WindowsApps\<包名>\，该目录只读且受保护，首次建库
         Directory.CreateDirectory 必定 Access Denied。MSIX 已不再提供 App-V 时代的
         VFS 写重定向，写安装目录就是失败，没有绕过的余地。
      2. 卸载会带走数据。打包应用的 %LOCALAPPDATA% 被重定向到
         %LOCALAPPDATA%\Packages\<PFN>\LocalCache\，卸载即清空——密码管理器不能接受。
      3. 强制签名。自签只能本机或预装根证书的机器侧载；对外分发需要 CA 证书
         （硬件令牌或 Azure Trusted Signing），是持续成本。

      更根本的：本程序"整个文件夹就是一份可带走的实例，拷到 U 盘就能用"，
      MSIX 直接否定这个定位。

      EnableMsixTooling=true 只影响 VS 里"打包"菜单项是否出现，在
      WindowsPackageType=None 下不参与构建；留 true 是为了与 WinUI 模板一致、
      避免以后升级工具链时碰到"缺少某 targets"的报错。改成 false 也不会有行为差异，
      但不要因此以为打开它就等于能出 MSIX。

      将来真要转 MSIX，缺任何一条都跑不通：
        · 数据目录迁到 %LOCALAPPDATA%\FastPassword，且不能用 Packages 虚拟目录，
          否则卸载丢库；已有用户数据需要迁移
        · 补 Package.appxmanifest + 全套磁贴资源（现在只有 app.ico）
        · app.manifest 里的 dpiAwareness / longPathAware 迁到 appxmanifest
        · 配签名（VS 临时自签证书只够本机验证）
        · 补装 VS 的"Windows 应用开发"工作负载（本机目前没有 DesktopBridge targets）
      托盘（Shell_NotifyIcon）与单实例（Local\ 前缀命名 Mutex）在 runFullTrust 下
      无需改动。

      └────────────────────────────────────────────────────────────────────────┘
    -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!--
      <b>用组件包而不是聚合包</b>：<c>Microsoft.WindowsAppSDK</c>（umbrella）会把整个
      Windows AI/ML 栈拖进依赖图——onnxruntime.dll 20 MB + DirectML.dll 18 MB，
      合计约 40 MB 的本程序一个字节都用不到（这个程序不碰任何 AI/ML API）。
      发布时会把这些用不到的 DLL 一起带上，体积直接翻倍。
      <para>
      这里只引两个真正需要的组件：<c>.WinUI</c>（XAML 框架）+ <c>.Runtime</c>（框架依赖时的
      bootstrapper）。想要自包含（目标机什么都不用装）就两个都留；
      只想要最小体积就只留 .WinUI。
      </para>
      版本说明：.WinUI 与 .Runtime 的版本号可以不同（前者是 XAML 框架，后者是运行时），
      各自跟随自己的发布节奏。
    -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.5.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FastPassword.Core\FastPassword.Core.csproj" />
    <!-- 持久化层单独成项目：不依赖 WinUI，才能被单元测试直接驱动。 -->
    <ProjectReference Include="..\FastPassword.Storage\FastPassword.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 托盘图标运行时从 exe 同目录的 Assets\app.ico 加载 -->
    <Content Include="Assets\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- 用户手册随发布产物一起走（两个发布配置共用），接收方解压就能看到 -->
    <Content Include="..\..\docs\使用说明.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>使用说明.md</Link>
    </Content>
  </ItemGroup>

</Project>
