<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FastPassword.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>

    <Grid x:Name="ShellGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏：左侧标题，右侧使用要点、锁定与设置。系统的最小化/关闭按钮由 ExtendsContentIntoTitleBar 浮在更右侧。 -->
        <Grid x:Name="TitleBarArea" Grid.Row="0" Height="32" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <!--
                    给系统的最小化/最大化/关闭按钮让位。做成固定列而不是给按钮加 Margin：
                    设置按钮在锁定态是 Collapsed 的，Margin 会跟着一起消失，
                    锁定按钮就会右移压到系统按钮下面。
                -->
                <ColumnDefinition Width="138" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="16,0,0,0"
                        Spacing="2">

                <TextBlock Text="FastPassword"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <!-- 版本号本身就是入口：点开看版本、算法、运行时与数据目录 -->
                <Button x:Name="AboutButton"
                        Height="24"
                        Padding="6,0"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="4"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Click="OnShowAbout"
                        ToolTipService.ToolTip="版本信息">
                    <TextBlock x:Name="AboutButtonText" Text="v0.0.0" />
                </Button>
            </StackPanel>

            <!-- 使用要点：第一次启动会自动弹一次，之后从这里随时回看。
                 锁定态也保留——第一次进来正是锁定态，用户要能自己找到它。 -->
            <Button Grid.Column="1"
                    x:Name="TipsButton"
                    Width="40"
                    Height="32"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="0"
                    Click="OnShowTips"
                    ToolTipService.ToolTip="使用要点">
                <FontIcon Glyph="&#xE783;"
                          FontSize="14"
                          Foreground="{ThemeResource SystemFillColorCautionBrush}" />
            </Button>

            <Button Grid.Column="2"
                    x:Name="LockButton"
                    Width="40"
                    Height="32"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="0"
                    Click="OnLockClick"
                    Visibility="{x:Bind ViewModel.IsUnlocked, Mode=OneWay}"
                    ToolTipService.ToolTip="锁定">
                <FontIcon Glyph="&#xE72E;" FontSize="14" />
            </Button>

            <!-- 设置：锁定态不显示。解锁前能改的只有外观与防截屏，
                 但这些都属于"界面配置"，暴露一个可点入口没有好处。 -->
            <Button Grid.Column="3"
                    x:Name="SettingsButton"
                    Width="40"
                    Height="32"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="0"
                    Click="OnOpenSettings"
                    Visibility="{x:Bind ViewModel.IsUnlocked, Mode=OneWay}"
                    ToolTipService.ToolTip="设置">
                <FontIcon Glyph="&#xE713;" FontSize="14" />
            </Button>
        </Grid>

        <!-- 内容宿主：锁定页与主界面互斥显示，两者共用同一块区域，切换时不改变窗口尺寸。 -->
        <Grid x:Name="ContentHost"
              Grid.Row="1"
              KeyboardAcceleratorPlacementMode="Hidden">

            <Grid.KeyboardAccelerators>
                <KeyboardAccelerator Key="Escape" Invoked="OnEscapePressed" />
            </Grid.KeyboardAccelerators>

            <!-- ================= 锁定页 ================= -->
            <!-- 首次使用是"设置记忆密码"，之后是"解锁"。两条路都在 VM 里走一次 Argon2id。 -->
            <Grid x:Name="LockPanel"
                  Padding="48,16,48,32"
                  Visibility="{x:Bind ViewModel.IsLocked, Mode=OneWay}">

                <StackPanel Width="360"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12">

                    <!-- ===== 密码模式 ===== -->
                    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsPasswordMode, Mode=OneWay}">

                    <TextBlock Text="{x:Bind ViewModel.LockTitle, Mode=OneWay}"
                               FontSize="20"
                               FontWeight="SemiBold" />

                    <TextBlock Text="{x:Bind ViewModel.LockSubtitle, Mode=OneWay}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <!-- 记忆密码：强度条以背景填充画进输入框本体 -->
                    <Grid>
                        <PasswordBox x:Name="UnlockBox"
                                     Header="记忆密码"
                                     PlaceholderText="只存在于内存中，不会写入磁盘"
                                     PasswordRevealMode="Peek"
                                     KeyDown="OnUnlockKeyDown" />
                        <Rectangle Fill="{x:Bind ViewModel.StrengthBrush, Mode=OneWay}"
                                   Opacity="0.2"
                                   RadiusX="4" RadiusY="4"
                                   Height="32"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Bottom"
                                   RenderTransformOrigin="0,0.5"
                                   IsHitTestVisible="False">
                            <Rectangle.RenderTransform>
                                <ScaleTransform x:Name="StrengthScale" ScaleX="0" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>

                    <!-- 只在首次设置时出现：一个没有找回方式的密码，必须输两遍。 -->
                    <PasswordBox x:Name="ConfirmBox"
                                 Header="再输一次"
                                 PlaceholderText="确认没有打错"
                                 PasswordRevealMode="Peek"
                                 Visibility="{x:Bind ViewModel.IsFirstRun, Mode=OneWay}"
                                 KeyDown="OnUnlockKeyDown" />

                    <TextBlock Text="{x:Bind ViewModel.UnlockMessage, Mode=OneWay}"
                               Visibility="{x:Bind ViewModel.HasUnlockMessage, Mode=OneWay}"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" />

                    <Button Content="{x:Bind ViewModel.UnlockButtonText, Mode=OneWay}"
                            Command="{x:Bind ViewModel.UnlockCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Margin="0,4,0,0" />

                    <ProgressRing Width="20"
                                  Height="20"
                                  IsActive="{x:Bind ViewModel.IsUnlocking, Mode=OneWay}" />

                    <HyperlinkButton Content="忘记记忆密码？"
                                     HorizontalAlignment="Center"
                                     Visibility="{x:Bind ViewModel.HasVault, Mode=OneWay}"
                                     Command="{x:Bind ViewModel.ShowRecoveryCommand}" />
                    </StackPanel>

                    <!-- ===== 备份密钥模式（BitLocker 式恢复） ===== -->
                    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsRecoveryMode, Mode=OneWay}">

                        <TextBlock Text="用备份密钥解锁"
                                   FontSize="20"
                                   FontWeight="SemiBold" />

                        <TextBlock Text="输入首次设置记忆密码时保存的那串密钥（8 组 × 4 位）。解锁后你会看到自己的记忆密码。"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <TextBox x:Name="RecoveryBox"
                                 Header="备份密钥"
                                 PlaceholderText="XXXX-XXXX-XXXX-XXXX-XXXX-XXXX-XXXX-XXXX"
                                 FontFamily="Consolas"
                                 Text="{x:Bind ViewModel.RecoveryInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="OnRecoverKeyDown" />

                        <TextBlock Text="{x:Bind ViewModel.RecoveryMessage, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.HasRecoveryMessage, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" />

                        <Button Content="解锁"
                                Command="{x:Bind ViewModel.RecoverCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" />

                        <ProgressRing Width="20"
                                      Height="20"
                                      IsActive="{x:Bind ViewModel.IsRecovering, Mode=OneWay}" />

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="16">
                            <HyperlinkButton Content="返回"
                                             Command="{x:Bind ViewModel.CancelRecoveryCommand}" />
                            <HyperlinkButton Content="备份密钥也丢了？清空重来"
                                             Click="OnResetVault" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- ================= 主界面（解锁后） ================= -->
            <Grid x:Name="RootGrid"
                  KeyDown="OnRootKeyDown"
                  Visibility="{x:Bind ViewModel.IsUnlocked, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="252" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左栏：账号清单 -->
                <Grid Grid.Column="0" Padding="16,8,10,16" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBox PlaceholderText="搜索名称 / 账号 / 代号 / 备注"
                             Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <Grid Grid.Row="1">
                        <ListView x:Name="AccountList"
                                  ItemsSource="{x:Bind ViewModel.Accounts}"
                                  SelectionMode="Single"
                                  SelectionChanged="OnAccountSelectionChanged"
                                  HorizontalContentAlignment="Stretch">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <!-- 第一行名称、第二行账号 -->
                                    <StackPanel Padding="0,6" Spacing="2">
                                        <TextBlock Text="{Binding DisplayTitle}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding DisplaySubtitle}"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock Text="{x:Bind ViewModel.EmptyAccountsHint, Mode=OneWay}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="8,0"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="{x:Bind ViewModel.HasNoAccounts, Mode=OneWay}" />
                    </Grid>

                    <!-- 新增 / 删除 各占一半宽度 -->
                    <Grid Grid.Row="2" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="新增"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Click="OnNewAccount" />

                        <Button Grid.Column="1"
                                Content="删除所选"
                                Click="OnDeleteAccount"
                                IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" />
                    </Grid>
                </Grid>

                <Rectangle Grid.Column="1"
                           Width="1"
                           HorizontalAlignment="Center"
                           Fill="{ThemeResource CardStrokeColorDefaultBrush}" />

                <!-- 右栏：当前站点。浏览态整片置灰，只有「修改」能解锁。 -->
                <Grid Grid.Column="2" Padding="20,8,24,16" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBox Grid.Row="0"
                             Header="名称"
                             PlaceholderText="例如 GitHub 工作账号（只作标签，不影响密码）"
                             IsEnabled="{x:Bind ViewModel.IsFormEditable, Mode=OneWay}"
                             Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- 账号：参与派生 -->
                    <Grid Grid.Row="1" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Header="账号"
                                 PlaceholderText="登录名或邮箱（参与密码计算）"
                                 IsEnabled="{x:Bind ViewModel.IsFormEditable, Mode=OneWay}"
                                 Text="{x:Bind ViewModel.Account, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <Button Grid.Column="1"
                                Height="32"
                                VerticalAlignment="Bottom"
                                Command="{x:Bind ViewModel.CopyAccountCommand}"
                                ToolTipService.ToolTip="复制账号">
                            <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                        </Button>
                    </Grid>

                    <!-- 区分代号：参与派生 -->
                    <TextBox Grid.Row="2"
                             x:Name="SiteBox"
                             Header="区分代号"
                             PlaceholderText="例如 github.com、招商银行、公司 VPN"
                             IsEnabled="{x:Bind ViewModel.IsFormEditable, Mode=OneWay}"
                             Text="{x:Bind ViewModel.Site, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- 参数 -->
                    <Grid Grid.Row="3" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Text="长度" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ComboBox HorizontalAlignment="Stretch"
                                      IsEnabled="{x:Bind ViewModel.IsFormEditable, Mode=OneWay}"
                                      ItemsSource="{x:Bind ViewModel.LengthOptions}"
                                      SelectedIndex="{x:Bind ViewModel.LengthIndex, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="字符集" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ComboBox HorizontalAlignment="Stretch"
                                      IsEnabled="{x:Bind ViewModel.IsFormEditable, Mode=OneWay}"
                                      ItemsSource="{x:Bind ViewModel.CharsetOptions}"
                                      SelectedIndex="{x:Bind ViewModel.CharsetIndex, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>

                    <!-- 生成：浏览态也允许点（重算一次而已，不该因为只读就变灰） -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="12">
                        <Button Content="生成密码"
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.GenerateImmediatelyCommand}" />
                        <ProgressRing Width="20"
                                      Height="20"
                                      VerticalAlignment="Center"
                                      IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                    </StackPanel>

                    <!-- 结果 -->
                    <Border Grid.Row="5"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="0">
                        <!-- 剪贴板倒计时背景：从右往左缩短，到零时剪贴板被清除。ScaleX 用左边缘做锚点。 -->
                        <Grid>
                            <Rectangle Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                       Opacity="0.16"
                                       RadiusX="8" RadiusY="8"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch"
                                       RenderTransformOrigin="0,0.5"
                                       IsHitTestVisible="False">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="ClipboardScale" ScaleX="0" />
                                </Rectangle.RenderTransform>
                            </Rectangle>

                            <Grid Padding="16" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="密码" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.DisplayPassword, Mode=OneWay}"
                                               FontFamily="Consolas"
                                               FontSize="22"
                                               IsTextSelectionEnabled="True"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <Button Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Command="{x:Bind ViewModel.ToggleRevealCommand}"
                                        ToolTipService.ToolTip="显示 / 隐藏">
                                    <FontIcon Glyph="&#xE7B3;" FontSize="16" />
                                </Button>

                                <Button Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Command="{x:Bind ViewModel.CopyCommand}"
                                        IsEnabled="{x:Bind ViewModel.CanCopy, Mode=OneWay}"
                                        ToolTipService.ToolTip="复制">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="16" />
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 备注 -->
                    <TextBox Grid.Row="6"
                             Header="备注"
                             PlaceholderText="可选，例如「工作邮箱，二次验证在手机」"
                             IsEnabled="{x:Bind ViewModel.IsFormEditable, Mode=OneWay}"
                             Text="{x:Bind ViewModel.Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- 底部按钮：压在窗口下沿，与左栏的新增/删除同一水平线 -->
                    <StackPanel Grid.Row="7"
                                Orientation="Horizontal"
                                Spacing="8"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                        <Button Content="{x:Bind ViewModel.EditButtonText, Mode=OneWay}"
                                MinWidth="96"
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.ToggleEditCommand}" />

                        <Button Content="取消"
                                MinWidth="96"
                                Command="{x:Bind ViewModel.CancelCommand}" />
                    </StackPanel>
                </Grid>
            </Grid>
            <!-- ================= 备份密钥展示（覆盖层） ================= -->
            <!-- 只在两个时刻出现：首次创建之后、以及解锁状态下重新生成之后。
                 关掉就没了——库里只有密文，程序再也显示不出明文。 -->
            <Grid x:Name="RecoveryKeyPanel"
                  Padding="48,32"
                  Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                  Visibility="{x:Bind ViewModel.IsShowingRecoveryKey, Mode=OneWay}">

                <StackPanel Width="440"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="14">

                    <TextBlock Text="备份密钥（只显示这一次）"
                               FontSize="20"
                               FontWeight="SemiBold" />

                    <TextBlock Text="忘记记忆密码时，用它可以把记忆密码找回来。请抄到纸上，或存进你自己的密码管理器。程序不会保存明文，关掉这个窗口就再也看不到它了。"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                        <TextBlock Text="{x:Bind ViewModel.RecoveryKeyText, Mode=OneWay}"
                                   FontFamily="Consolas"
                                   FontSize="20"
                                   CharacterSpacing="60"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True" />
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="复制" Click="OnCopyRecoveryKey" />
                        <Button Content="保存为文本文件…" Click="OnSaveRecoveryKey" />
                    </StackPanel>

                    <Button Content="我已抄下，继续"
                            Command="{x:Bind ViewModel.AcknowledgeRecoveryKeyCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
