<?xml version="1.0" encoding="utf-8"?>
<Project>

  <!--
    精简发布配置：不打包任何运行时，zip 只有几 MB。
    接收方必须先装好两个运行时（均为 x64），否则无法启动：
      1. .NET Desktop Runtime 10.0
      2. Windows App Runtime 2.5.x（Windows App SDK 官网 runtime installer）
    用法：dotnet publish src/FastPassword.App -c Release -p:PublishProfile=win-x64-frameworkdependent
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- 关键开关：两个运行时都不随包带 -->
    <SelfContained>false</SelfContained>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>

    <!-- 产物落 dist\FastPassword-lite\，与自包含包互不覆盖。
         用 MSBuildThisFileDirectory 定位，避免相对路径被解析到意外位置。 -->
    <PublishDir>$(SolutionDir)..\..\dist\FastPassword-lite\</PublishDir>

    <!-- 只保留英文和简中文案 -->
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>

    <!--
      发布目录不带符号文件：FastPassword / Core / Storage 三个 .pdb 共约 105 KB，
      对运行毫无用处，只会让"解压出来一堆文件"更难看。
      调试请直接跑 bin\ 里的编译产物（那边 pdb 齐全），发布产物只负责分发。
    -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- 引用项目（Core / Storage）的 .pdb 也要拦掉：DebugType 只管本项目自己的 -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

</Project>
