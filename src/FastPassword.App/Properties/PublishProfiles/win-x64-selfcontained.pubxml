<?xml version="1.0" encoding="utf-8"?>
<Project>

  <!--
    自包含发布配置：产物自带 .NET 10 与 Windows App SDK 运行时，
    对方机器什么都不用装（Win10 1809+ x64），解压双击 FastPassword.exe 即用。
    用法：dotnet publish src/FastPassword.App -c Release -p:PublishProfile=win-x64-selfcontained
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- .NET 运行时一起打包，不依赖对方装过 Desktop Runtime -->
    <SelfContained>true</SelfContained>

    <!-- Windows App SDK 运行时一起打包，不依赖对方装过 Windows App Runtime -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

    <!-- WinUI 3 的 XAML 元数据不走反射裁剪安全区，裁剪等于赌运气，明确关掉 -->
    <PublishTrimmed>false</PublishTrimmed>

    <!--
      产物落 dist\FastPassword\，与其它两个发布配置互不覆盖。
      <b>用 MSBuildThisFileDirectory 定位</b>：写相对路径 "..\..\dist\..." 时，
      publish 的工作目录会变，导致路径被解析到意外位置
      （实测出现过 "WorkBuddyfastpassworddistFastPassword" 这种畸形目录）。
    -->
    <PublishDir>$(SolutionDir)..\..\dist\FastPassword\</PublishDir>

    <!-- 只保留英文和简中文案，去掉几十个用不到的语言资源文件夹 -->
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
