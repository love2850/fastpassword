<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FastPassword.App.Views.AccountDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 与主窗/设置窗同一套外观：无标题栏 + Mica + 自定义拖拽区。
         用独立 Window 而不是 ContentDialog：主窗高度预算紧张，对话框再压一层会把按钮挤出可见区。 -->
    <Grid x:Name="ShellGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarArea" Grid.Row="0" Height="32" Background="Transparent">
            <TextBlock Text="新增账号"
                       Margin="16,0,0,0"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <Grid Grid.Row="1" Padding="24,4,24,20" KeyboardAcceleratorPlacementMode="Hidden">
            <Grid.KeyboardAccelerators>
                <KeyboardAccelerator Key="Escape" Invoked="OnEscapePressed" />
            </Grid.KeyboardAccelerators>

            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">

                <StackPanel Spacing="12">
                    <TextBox x:Name="NameBox"
                             Header="名称"
                             PlaceholderText="例如 GitHub 工作账号（只作标签，不影响密码）" />

                    <TextBox x:Name="AccountBox"
                             Header="账号"
                             PlaceholderText="登录名或邮箱（参与密码计算）" />

                    <TextBox x:Name="SiteBox"
                             Header="区分代号"
                             PlaceholderText="例如 github.com、招商银行" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Text="长度"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ComboBox x:Name="LengthBox" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="12" />
                                <ComboBoxItem Content="16" />
                                <ComboBoxItem Content="20" />
                                <ComboBoxItem Content="24" />
                                <ComboBoxItem Content="32" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="字符集"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ComboBox x:Name="CharsetBox" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="字母数字" />
                                <ComboBoxItem Content="字母数字符号" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <TextBox x:Name="NoteBox"
                             Header="备注"
                             PlaceholderText="可选，例如「二次验证在手机」"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="72" />

                    <TextBlock x:Name="ErrorText"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="1" Margin="0,16,0,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1" Content="取消" MinWidth="96" Click="OnCancel" />

                <Button Grid.Column="2"
                        Content="保存"
                        MinWidth="96"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="OnSave" />
            </Grid>
        </Grid>
    </Grid>
</Window>
