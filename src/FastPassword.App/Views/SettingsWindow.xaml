<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FastPassword.App.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        与主窗同一套外观：无标题栏 + Mica + 自定义拖拽区。
        每一行都是「左边标题文字、右边控件」，说明文字全部改成悬停标题时的 ToolTip——
        这样 8 组设置能在一屏内看完，也不会出现长文案把行撑成两行。
    -->
    <Grid x:Name="ShellGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarArea" Grid.Row="0" Height="32" Background="Transparent">
            <TextBlock Text="设置"
                       Margin="16,0,0,0"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <Grid Grid.Row="1" Padding="24,4,24,20" KeyboardAcceleratorPlacementMode="Hidden">
            <Grid.KeyboardAccelerators>
                <KeyboardAccelerator Key="Escape" Invoked="OnEscapePressed" />
            </Grid.KeyboardAccelerators>

            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Disabled"
                          VerticalScrollMode="Auto">

                <StackPanel>

                    <!-- 剪贴板自动清除 -->
                    <Grid MinHeight="52">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="复制后自动清除剪贴板"
                                   VerticalAlignment="Center" />

                        <ComboBox Grid.Column="1"
                                  x:Name="ClipboardBox"
                                  Width="150"
                                  VerticalAlignment="Center">
                            <ComboBoxItem Content="不清除" />
                            <ComboBoxItem Content="10 秒" />
                            <ComboBoxItem Content="15 秒" />
                            <ComboBoxItem Content="30 秒" />
                        </ComboBox>
                    </Grid>

                    <!-- 窗口内快捷键：只在本程序窗口有焦点时生效，不注册全局热键 -->
                    <Grid MinHeight="52">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="启用快捷键"
                                   VerticalAlignment="Center"
                                   ToolTipService.ToolTip="Ctrl+C 复制所选条目的密码，Ctrl+B 复制账号。仅在窗口内生效，不占用全局热键。" />

                        <ToggleSwitch Grid.Column="1"
                                      x:Name="ShortcutSwitch"
                                      MinWidth="0"
                                      VerticalAlignment="Center"
                                      OnContent=""
                                      OffContent="" />
                    </Grid>

                    <!-- 隐藏后自动锁定 -->
                    <Grid MinHeight="52">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="隐藏 10 秒后自动锁定"
                                   VerticalAlignment="Center" />

                        <ToggleSwitch Grid.Column="1"
                                      x:Name="LockSwitch"
                                      MinWidth="0"
                                      VerticalAlignment="Center"
                                      OnContent=""
                                      OffContent="" />
                    </Grid>

                    <!-- 防截屏 -->
                    <Grid MinHeight="52">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="防截屏"
                                   VerticalAlignment="Center" />

                        <ToggleSwitch Grid.Column="1"
                                      x:Name="CaptureSwitch"
                                      MinWidth="0"
                                      VerticalAlignment="Center"
                                      OnContent=""
                                      OffContent="" />
                    </Grid>

                    <!-- 失焦自动隐藏 -->
                    <Grid MinHeight="52">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="失焦自动隐藏"
                                   VerticalAlignment="Center" />

                        <ToggleSwitch Grid.Column="1"
                                      x:Name="HideSwitch"
                                      MinWidth="0"
                                      VerticalAlignment="Center"
                                      OnContent=""
                                      OffContent="" />
                    </Grid>

                    <!-- 关闭按钮行为 -->
                    <Grid MinHeight="52">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="关闭按钮收进托盘"
                                   VerticalAlignment="Center" />

                        <ToggleSwitch Grid.Column="1"
                                      x:Name="TraySwitch"
                                      MinWidth="0"
                                      VerticalAlignment="Center"
                                      OnContent=""
                                      OffContent="" />
                    </Grid>

                    <!-- 外观 -->
                    <Grid MinHeight="52">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="外观"
                                   VerticalAlignment="Center" />

                        <ComboBox Grid.Column="1"
                                  x:Name="ThemeBox"
                                  Width="150"
                                  VerticalAlignment="Center"
                                  SelectionChanged="OnThemeSelectionChanged">
                            <ComboBoxItem Content="跟随系统" />
                            <ComboBoxItem Content="浅色" />
                            <ComboBoxItem Content="深色" />
                        </ComboBox>
                    </Grid>

                    <!-- 备份密钥：只在解锁状态下可用（需要记忆密码才能重新包裹） -->
                    <Grid MinHeight="52">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="备份密钥"
                                   VerticalAlignment="Center" />

                        <Button Grid.Column="1"
                                x:Name="RegenerateButton"
                                Content="重新生成…"
                                MinWidth="150"
                                VerticalAlignment="Center"
                                Click="OnRegenerateRecoveryKey" />
                    </Grid>

                    <!-- 新密钥只在这里显示一次；收起设置窗就再也拿不到了 -->
                    <StackPanel x:Name="RecoveryKeyPanel" Visibility="Collapsed" Spacing="6" Margin="0,0,0,8">
                        <TextBlock Text="新的备份密钥（旧密钥已作废，只显示这一次）"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource SystemFillColorCautionBrush}" />

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10">
                            <TextBlock x:Name="RecoveryKeyText"
                                       FontFamily="Consolas"
                                       FontSize="16"
                                       CharacterSpacing="40"
                                       TextWrapping="Wrap"
                                       IsTextSelectionEnabled="True" />
                        </Border>

                        <Button Content="复制" Click="OnCopyRecoveryKey" />
                    </StackPanel>

                    <TextBlock x:Name="RecoveryError"
                               Visibility="Collapsed"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" />

                    <!-- 配置位置 -->
                    <StackPanel Margin="0,16,0,0" Spacing="4">
                        <TextBlock Text="配置位置"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="PathText"
                                   FontSize="12"
                                   IsTextSelectionEnabled="True"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- 按钮行固定底部，不参与滚动，永远不会被内容挤掉 -->
            <Grid Grid.Row="1" Margin="0,16,0,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1"
                        Content="取消"
                        MinWidth="96"
                        Click="OnCancel" />

                <Button Grid.Column="2"
                        Content="保存"
                        MinWidth="96"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="OnSave" />
            </Grid>
        </Grid>
    </Grid>
</Window>
