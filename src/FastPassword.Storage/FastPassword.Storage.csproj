<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FastPassword.Storage</RootNamespace>
    <AssemblyName>FastPassword.Storage</AssemblyName>
  </PropertyGroup>

  <!--
    刻意不依赖 WinUI / WinRT：这一层只有 SQLite + 加密，所以能被单元测试直接驱动。
    历史上最危险的两个 bug（连接泄漏、按 (site, account) 合并覆盖另一条记录）都发生在这里，
    放在 App 里就意味着永远只能靠手工点界面验证。
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FastPassword.Core\FastPassword.Core.csproj" />
  </ItemGroup>

</Project>
